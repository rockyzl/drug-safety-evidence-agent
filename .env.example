EVIDENCE_PROVIDER=vertex
EVIDENCE_MODEL=google/gemini-3.8-flash
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
EMBEDDING_PROVIDER=vertex
EMBEDDING_MODEL=text-embedding-005
VERTEX_EMBEDDING_LOCATION=us-central1
# Authenticate with Google ADC, or use scripts/with_google_login.py locally.
# This file is a reference; the application does not load it automatically.
# Optional OpenAI: set provider=openai, model=gpt-4.1-mini,
# embedding provider=openai, embedding model=text-embedding-3-small,
# and OPENAI_API_KEY securely in your environment. Rebuild the matching index.
# Optional. No AWS credentials belong in this file or in Git.
# EVIDENCE_PROVIDER=bedrock
# BEDROCK_MODEL_ID=your-enabled-model-or-inference-profile-id
# AWS_REGION=us-east-1
# AWS_PROFILE=your-sso-profile
DAILY_RUN_LIMIT=80
